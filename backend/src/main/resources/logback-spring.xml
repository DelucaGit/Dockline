<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging for the Dockline backend.
  - Console and a rolling log file in the app-data folder (dockline.log.dir, see application.properties).
  - The file rolls over daily and when it reaches 10 MB; files older than 14 days are deleted, and all
    files together never take more than 100 MB.
  - Everything written (message and stack trace) goes through %mask(...), so tokens are never written.
-->
<configuration>
  <conversionRule conversionWord="mask" class="io.github.delucagit.dockline.log.MaskingConverter"/>

  <springProperty name="LOG_DIR" source="dockline.log.dir" defaultValue="logs"/>

  <property name="LINE" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n%xException"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%mask(${LINE})</pattern>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/dockline.log</file>
    <encoder>
      <pattern>%mask(${LINE})</pattern>
      <charset>UTF-8</charset>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/dockline.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <maxHistory>14</maxHistory>
      <totalSizeCap>100MB</totalSizeCap>
      <cleanHistoryOnStart>true</cleanHistoryOnStart>
    </rollingPolicy>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
