<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>io.github.delucagit</groupId>
  <artifactId>dockline-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>dockline-backend</name>
  <description>Local REST backend for the Dockline desktop app</description>

  <properties>
    <java.version>25</java.version>
    <springdoc.version>3.2.0</springdoc.version>
    <springdoc-maven-plugin.version>1.6</springdoc-maven-plugin.version>
    <!-- Port used only while the build starts the app to export the OpenAPI file -->
    <openapi.export.port>18089</openapi.export.port>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>start-for-openapi-export</id>
            <phase>pre-integration-test</phase>
            <goals><goal>start</goal></goals>
            <configuration>
              <arguments>
                <argument>--server.port=${openapi.export.port}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>stop-after-openapi-export</id>
            <phase>post-integration-test</phase>
            <goals><goal>stop</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-maven-plugin</artifactId>
        <version>${springdoc-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>export-openapi</id>
            <phase>integration-test</phase>
            <goals><goal>generate</goal></goals>
          </execution>
        </executions>
        <configuration>
          <apiDocsUrl>http://localhost:${openapi.export.port}/v3/api-docs</apiDocsUrl>
          <outputDir>${project.basedir}</outputDir>
          <outputFileName>openapi.json</outputFileName>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
